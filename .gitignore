public/lesson/tornado/narration-hashes.json
public/lesson/home-fire/jobs.json
public/lesson/home-fire/source/
public/lesson/home-fire/narration-hashes.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
